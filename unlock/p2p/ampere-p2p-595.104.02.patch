+/* SPDX-License-Identifier: MIT
+ * Local 595.104.02 trial: only the two inventoried Ampere boards.
+ * PCI/subsystem dwords use device ID in the upper half, vendor in the lower.
+ */
+#ifndef GPU_P2P_TRIAL_H
+#define GPU_P2P_TRIAL_H
+#include "gpu/gpu.h"
+#include "os/os.h"
+static NV_INLINE NvBool gpuP2pTrialTarget(OBJGPU *pGpu)
+{
+    NvU32 deviceId;
+    NvU32 subsystemId;
+
+    if (pGpu == NULL)
+        return NV_FALSE;
+
+    deviceId = pGpu->idInfo.PCIDeviceID;
+    subsystemId = pGpu->idInfo.PCISubDeviceID;
+
+    // KernelBif is constructed before gpuGetIdInfo_HAL and _gpuInitChipInfo.
+    // The OS PCI handle is already initialized by gpuPostConstruct_IMPL.
+    // Read identification only; do not write PCI configuration or relax IDs.
+    if (deviceId == 0 || subsystemId == 0)
+    {
+        if (pGpu->hPci == NULL)
+            return NV_FALSE;
+        deviceId = osPciReadDword(pGpu->hPci, 0x00);
+        subsystemId = osPciReadDword(pGpu->hPci, 0x2c);
+    }
+
+    return (deviceId == 0x248910deU && subsystemId == 0x1389196eU) ||
+           (deviceId == 0x221610deU && subsystemId == 0x161219daU);
+}
+#endif
